{
  "name": "@tempo/ios-runtime",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir dist",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:brownfield:ios": "expo-brownfield build:ios --release --package TempoRuntimePackage --verbose",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production"
  },
  "dependencies": {
    "expo": "57.0.10",
    "expo-brownfield": "~57.0.24",
    "expo-build-properties": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-modules-core": "57.0.9",
    "expo-modules-jsi": "57.0.4"
  }
}
