server_deploy/.env
server_deploy/.env.local
server_deploy/.env.*.local
server_deploy/nginx.conf
server_deploy/docker-compose.override.yml
server_deploy/logs/
server_deploy/data/
server_deploy/uploads/
server_deploy/backups/
server_deploy/releases/
server_deploy/patches/

