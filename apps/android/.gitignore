# ─────────────────────────────────────────────────────────────
# Other
# ─────────────────────────────────────────────────────────────
# Application artwork under assets/ and Android res/ is source code and must
# remain tracked. Keep generated screenshots out by placing them under build/
# or another ignored output directory instead of ignoring all image files.
.env.production.local
.env.development.local
.env.test.local
